# Expo inlines only EXPO_PUBLIC_* variables. Copy to `.env` and restart the bundler after editing.

# Base URL for REST calls, including the /api prefix (matches the Express mounts in backend/src/app.js).
# Leave unset in development: the app derives the dev machine's LAN address from the Expo packager
# (see src/config/env.ts) so a physical phone reaches `npm run dev` in backend/ with no configuration.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000/api

# Socket.IO origin. Defaults to EXPO_PUBLIC_API_BASE_URL without the /api suffix.
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.20:5000

# EXPO_PUBLIC_APP_NAME=Foose

# Storage keys. The defaults are deliberately distinct from the web app's `thrift.*` keys.
# EXPO_PUBLIC_AUTH_STORAGE_KEY=foose.mobile.auth.tokens
# EXPO_PUBLIC_CART_STORAGE_KEY=foose.mobile.cart
